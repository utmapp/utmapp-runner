LANG=en_US.UTF-8
http_proxy=http://@SQUID_PROXY_HOST@:@SQUID_PROXY_PORT@
https_proxy=http://@SQUID_PROXY_HOST@:@SQUID_PROXY_PORT@
NODE_EXTRA_CA_CERTS=@SQUID_CA_PEM@
SSL_CERT_FILE=@SQUID_CA_BUNDLE@
REQUESTS_CA_BUNDLE=@SQUID_CA_BUNDLE@
CURL_CA_BUNDLE=@SQUID_CA_BUNDLE@
BOTO_CONFIG=@RUNNER_HOME@/.boto
NO_AUTH_BOTO_CONFIG=@RUNNER_HOME@/.boto
ACTIONS_RUNNER_HOOK_JOB_STARTED=@RUNNERS_ROOT@/cleanup.sh
